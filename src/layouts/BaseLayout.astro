---
import "../styles/global.css";
import { toPublicAssetUrl } from "../lib/assets";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  twitterCard?: "summary" | "summary_large_image";
}

const {
  title = "Agile MAPF Project Page",
  description = "Concrete Multi-Agent Path Planning project page",
  ogImage = "/images/40robots_1.jpg",
  ogType = "website",
  twitterCard = "summary_large_image",
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();
const resolvedOgImage = toPublicAssetUrl(ogImage);
const ogImageUrl = Astro.site
  ? new URL(resolvedOgImage, Astro.site).toString()
  : resolvedOgImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
